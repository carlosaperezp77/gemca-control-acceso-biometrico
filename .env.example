# Copia este archivo como ".env" y completa los tokens de cada equipo.
# NUNCA subas el archivo ".env" real a ningún repositorio ni lo compartas
# fuera de GEMCA: esos tokens son lo único que protege los endpoints de
# ingesta de eventos.

PORT=3000

# Usuario y clave para entrar al panel (y a la API de consulta). SIN esto
# configurado, el panel queda abierto a cualquiera con el enlace — hay que
# definirlo antes de desplegar en la nube. Usa una clave propia y distinta
# a cualquier otra que uses en GEMCA.
PANEL_USER=
PANEL_PASS=

# --- Lector de Zona Industrial -----------------------------------------
DEVICE_ZI_MODEL=DS-K1T321MFWX
# Token propio de este equipo: se genera una sola vez (ver README) y se
# configura TANTO aquí como en el equipo, al dar de alta el envío de
# eventos hacia esta App.
DEVICE_ZI_TOKEN=

# --- Lector de Tienda (Sede Principal) ----------------------------------
DEVICE_TIENDA_MODEL=DS-K1A802MF201
DEVICE_TIENDA_TOKEN=

# -------------------------------------------------------------------------
# Lo de abajo es OPCIONAL: solo se usa si en el futuro se habilita una VPN
# o acceso directo a algún equipo, como respaldo de la consulta directa
# (pull). No es necesario para que la App funcione: el modo principal es
# que los equipos empujen sus eventos (arriba).
# -------------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=5
DEVICE_ZI_BASE_URL=
DEVICE_ZI_USER=admin
DEVICE_ZI_PASS=
DEVICE_TIENDA_BASE_URL=
DEVICE_TIENDA_USER=admin
DEVICE_TIENDA_PASS=
